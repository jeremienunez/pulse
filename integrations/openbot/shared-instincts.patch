index 0000000..847cc9b
--- /dev/null
+++ b/src/backend/shared-instincts-bridge.ts
@@ -0,0 +1,17 @@
+import type { AgentProvider } from "./agent-client";
+
+/**
+ * Boundary for an optional, locally-owned shared-instincts integration.
+ * The default implementation intentionally contributes no instructions and
+ * records no event. A host must provide a source-bound implementation before
+ * OpenBot can claim shared-instinct coverage.
+ */
+export interface SharedInstinctsBridge {
+  instructions(input: { agentId: string; provider: AgentProvider }): string | null;
+  threadClosed(input: { agentId: string; threadId: string }): void;
+}
+
+export const NO_SHARED_INSTINCTS_BRIDGE: SharedInstinctsBridge = {
+  instructions: () => null,
+  threadClosed: () => {},
+};
