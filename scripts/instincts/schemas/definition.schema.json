{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "name", "id", "type", "version", "purpose", "status", "priority", "trigger_conditions", "watched_events", "default_behavior", "failure_patterns", "intervention_rules", "escalation_rules", "confidence_rules", "output_contract", "examples", "anti_examples"],
  "properties": {
    "namespace": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
    "type": {"const": "agent_instinct"},
    "version": {"type": "string"},
    "purpose": {"type": "string"},
    "status": {"enum": ["experimental", "draft", "stable", "deprecated"]},
    "priority": {"enum": ["low", "medium", "high", "critical"]},
    "trigger_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "watched_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["before_file_edit", "before_shell_command", "before_dependency_add", "before_architecture_change", "before_release", "before_claiming_success", "after_test_failure", "after_user_correction", "after_validation_failure", "before_docs_update", "before_marketing_claim", "before_public_api_change", "before_security_change"]}},
    "default_behavior": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "failure_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "intervention_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "escalation_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confidence_rules": {"type": "object", "additionalProperties": false, "required": ["require_high_confidence_for"], "properties": {"require_high_confidence_for": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "output_contract": {"type": "object", "additionalProperties": false, "required": ["required_sections"], "properties": {"required_sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "examples": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["input", "response"], "properties": {"input": {"type": "string", "minLength": 1}, "response": {"type": "string", "minLength": 1}}}},
    "anti_examples": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["input", "problem"], "properties": {"input": {"type": "string", "minLength": 1}, "problem": {"type": "string", "minLength": 1}}}},
    "extends": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
