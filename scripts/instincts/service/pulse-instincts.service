[Unit]
Description=Pulse shared-instincts deferred worker
ConditionPathExists=/media/jerem/ubuntu2/agent-instincts/jerem

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/media/jerem/ubuntu2/agent-instincts/runtime/venv/bin/python3 %h/.local/share/pulse/shared-instincts/current/scripts/pulse_instincts.py drain --all --root /media/jerem/ubuntu2/agent-instincts/jerem

[Install]
WantedBy=default.target
