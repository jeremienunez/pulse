{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulse code quality policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "profiles",
    "include"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "observe",
        "enforce-new"
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "metrics",
          "javascript",
          "frontend",
          "python",
          "rust",
          "native"
        ]
      }
    },
    "include": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern",
          "reason"
        ],
        "properties": {
          "pattern": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_lines": {
          "$ref": "#/$defs/budget"
        },
        "function_lines": {
          "$ref": "#/$defs/budget"
        },
        "class_lines": {
          "$ref": "#/$defs/budget"
        },
        "complexity": {
          "$ref": "#/$defs/budget"
        },
        "nesting": {
          "$ref": "#/$defs/budget"
        },
        "parameters": {
          "$ref": "#/$defs/budget"
        },
        "public_methods": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "strictBudgets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zones"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patterns",
              "allows"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patterns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "allows": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "io": {
                "type": "boolean"
              },
              "forbidPackages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/naming"
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "include"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedValues": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "localPattern": {
          "type": "string",
          "minLength": 1
        },
        "namePattern": {
          "type": "string",
          "minLength": 1
        },
        "requiredDynamic": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "command",
          "format",
          "profile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "format": {
            "enum": [
              "json",
              "sarif"
            ]
          },
          "profile": {
            "enum": [
              "commit",
              "ci"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "baseline": {
      "type": "string"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ruleId",
          "path",
          "owner",
          "reason",
          "expires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "unused": {
      "type": "boolean"
    },
    "clones": {
      "type": "boolean"
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "off",
          "info",
          "warning",
          "error"
        ]
      },
      "propertyNames": {
        "enum": [
          "abstraction/class",
          "abstraction/generic-utility",
          "abstraction/public-class",
          "abstraction/public-function",
          "abstraction/public-state",
          "abstraction/public-type",
          "abstraction/scope-ambiguity",
          "abstraction/static-class",
          "audit/*",
          "duplication/*",
          "eslint/*",
          "eslint/@typescript-eslint/no-unused-vars",
          "eslint/no-debugger",
          "eslint/no-restricted-globals",
          "naming/boolean",
          "naming/file",
          "naming/symbol",
          "native/*",
          "owner/cycle",
          "owner/import",
          "owner/package",
          "ruff/*",
          "ruff/C90*",
          "ruff/F*",
          "ruff/N*",
          "ruff/PLR*",
          "rust/*",
          "size/*",
          "size/class_lines",
          "size/complexity",
          "size/file_lines",
          "size/function_lines",
          "size/nesting",
          "size/parameters",
          "size/public_methods",
          "stylelint/*",
          "tokens/arbitrary-class-review",
          "tokens/definition-owner",
          "tokens/dynamic-review",
          "tokens/literal",
          "tokens/name",
          "tokens/unknown",
          "unused/*"
        ]
      }
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warning",
        "error"
      ],
      "properties": {
        "warning": {
          "type": "number",
          "minimum": 1
        },
        "error": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "enum": [
            "kebab",
            "snake",
            "pascal",
            "camel",
            "lower"
          ]
        },
        "symbols": {
          "type": "boolean"
        },
        "booleans": {
          "type": "boolean"
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patterns"
            ],
            "properties": {
              "patterns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "files": {
                "enum": [
                  "kebab",
                  "snake",
                  "pascal",
                  "camel",
                  "lower"
                ]
              },
              "symbols": {
                "type": "boolean"
              },
              "booleans": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
