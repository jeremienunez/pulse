{
  "kind": "pulse-visual-capabilities",
  "schema_version": "1.0",
  "availability_authority": "A current inspection of the selected local profile; these records alone perform no execution.",
  "capabilities": [
    {
      "id": "threading",
      "kind": "local-algorithm",
      "domain": "image stylization",
      "effect": "string art using segments between pegs",
      "input": {
        "role": "material",
        "formats": [
          "png",
          "jpeg"
        ],
        "rights_basis_required": true
      },
      "output": {
        "format": "svg",
        "native_vector": true,
        "grammar": "threading-specific rect/g/circle/line and one fixed style"
      },
      "controls": [
        "shape",
        "pegs",
        "lines",
        "opacity",
        "thickness",
        "display_pegs"
      ],
      "initial_profile": {
        "quality": 1,
        "mode": 0,
        "invert_colors": false,
        "blur": 0
      },
      "availability": {
        "status": "requires-current-inspection",
        "command": [
          "node",
          "scripts/pulse-threading-svg.mjs",
          "inspect",
          "--profile",
          "<absolute-local-profile>"
        ]
      },
      "runtime": {
        "source": "operator-supplied external directory",
        "node": "v24.15.0",
        "chrome": "155.0.8059.79",
        "platform": "linux-x64",
        "automatic_install": false
      },
      "provenance": {
        "repository": "https://github.com/piellardj/image-stylization-threading",
        "commit": "ef93733b28248340958c5843b5d882e6f4f5fef1",
        "license": "GPL-3.0",
        "runtime_bundled": false,
        "lock": "threading-source-lock.json"
      },
      "limits": [
        "closed local job and profile",
        "admitted operation required",
        "60-second deadline",
        "no universal determinism claim",
        "input-image permission is separate from program licence"
      ],
      "reference": "threading.md"
    },
    {
      "id": "primitive",
      "kind": "local-algorithm",
      "domain": "image approximation",
      "effect": "geometric approximation with supported shape exporters",
      "input": {
